# -----------------------------------------------------------------------------
# Database — Neon Postgres (serverless)
# -----------------------------------------------------------------------------
# Grab both URLs from the Neon console for the "khevlekh-uul" project.
# DATABASE_URL         → pooled (pgbouncer) URL, ends with "-pooler..."
# DATABASE_URL_UNPOOLED → direct URL, only used by `prisma migrate`
DATABASE_URL="postgresql://<user>:<pass>@ep-xxx-pooler.<region>.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<pass>@ep-xxx.<region>.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string"

# -----------------------------------------------------------------------------
# PrintNode — https://www.printnode.com/en/docs/api
# Install PrintNode Client on each partner shop's PC, then generate an API key
# in the PrintNode dashboard.
# -----------------------------------------------------------------------------
PRINTNODE_API_KEY=""

# -----------------------------------------------------------------------------
# Polar.sh — https://polar.sh
# Personal access token with product/checkout/webhook scopes on the Bichig org.
# Product IDs below were provisioned already; you only need to fill in the
# access token + webhook secret.
# -----------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""

POLAR_ORG_ID="9283aa18-071f-4438-a045-ad9a28900005"
POLAR_PRODUCT_ID_10="3372c44d-935b-402e-942f-ca0c6f9232c7"
POLAR_PRODUCT_ID_25="3d5beae5-efff-4e55-8997-aa471532ceaf"
POLAR_PRODUCT_ID_50="4a77827c-d1b9-4367-b124-c097c2d99689"

# Base URL used for Polar success/cancel redirects and webhook registration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Pricing (deducted from wallet per page). Default: 10¢ B/W, 30¢ color.
# Per-printer overrides live on the Printer.bwCentsPerPage / colorCentsPerPage
# columns.
# -----------------------------------------------------------------------------
PRICE_BW_CENTS_PER_PAGE=10
PRICE_COLOR_CENTS_PER_PAGE=30
