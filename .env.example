# Database (SQLite for dev; swap to Postgres URL in prod)
DATABASE_URL="file:./dev.db"

# Session secret (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# PrintNode - https://www.printnode.com/en/docs/api
# Create an account, install PrintNode Client on each partner shop machine,
# then generate an API key from the PrintNode dashboard.
PRINTNODE_API_KEY=""

# Polar.sh - https://polar.sh (Stripe-powered)
# Create an organization, a "Print Credits" product with wallet tiers,
# then generate a personal access token and webhook secret.
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_ORG_ID=""
# Optional: pin specific product IDs for wallet top-up tiers
POLAR_PRODUCT_ID_10=""
POLAR_PRODUCT_ID_25=""
POLAR_PRODUCT_ID_50=""

# Base URL used for Polar success/cancel redirects and webhooks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Pricing (in cents, USD) — deducted from user wallet per page.
# Default: 10¢ B/W, 30¢ color per page.
PRICE_BW_CENTS_PER_PAGE=10
PRICE_COLOR_CENTS_PER_PAGE=30
