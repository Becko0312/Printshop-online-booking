# Khevlekh Uul — Print Agent configuration
# Copy this file to `.env` and fill in the values shown on your merchant
# dashboard (Хэвлэгч холбох хэсэг).

# Your Khevlekh Uul site URL (no trailing slash).
API_BASE_URL="https://cloud-printing-saas.vercel.app"

# Agent token — unique to your merchant account. Keep it secret.
AGENT_TOKEN=""

# Optional: exact OS printer name/queue to print to.
# Leave empty to use the computer's default printer.
#   Linux/macOS: run `lpstat -p` to list queue names.
#   Windows:     Settings → Bluetooth & devices → Printers & scanners.
PRINTER_NAME=""

# How often (seconds) to check the server for new jobs.
POLL_SECONDS="5"

# Windows only: absolute path to SumatraPDF.exe (used to print).
# Download the portable build from https://www.sumatrapdfreader.org
# Example: SUMATRA_PATH="C:\\Tools\\SumatraPDF.exe"
SUMATRA_PATH=""
