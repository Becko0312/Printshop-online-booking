// Cloud Print SaaS – schema
// Datastore: Neon Postgres (serverless).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  phone         String?
  walletCents   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs          PrintJob[]
  transactions  WalletTx[]
  uploads       Upload[]
  redemptions   PromoRedemption[]
}

model Printer {
  id                 String   @id @default(cuid())
  // PrintNode numeric printer id (nullable while offline / newly added)
  printNodeId        Int?     @unique
  name               String
  location           String   // e.g. "СБД, 1-р хороо, Central Tower"
  district           String   // e.g. "Сүхбаатар дүүрэг"
  address            String?
  colorSupported     Boolean  @default(false)
  duplexSupported    Boolean  @default(false)
  active             Boolean  @default(true)
  operatorEmail      String?
  bwCentsPerPage     Int?     // per-printer override
  colorCentsPerPage  Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  jobs               PrintJob[]
}

model Upload {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  storedPath  String   // filesystem path under /uploads
  mimeType    String
  sizeBytes   Int
  pageCount   Int?     // best-effort page count for PDFs
  createdAt   DateTime @default(now())

  jobs        PrintJob[]
}

model PrintJob {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId       String
  upload         Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  printerId      String
  printer        Printer   @relation(fields: [printerId], references: [id])
  copies         Int       @default(1)
  color          Boolean   @default(false)
  duplex         Boolean   @default(false)
  pageCount      Int       @default(1)
  costCents      Int       @default(0)
  status         String    @default("queued") // queued | sent | printed | failed | canceled
  printNodeJobId Int?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model WalletTx {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // positive for top-up, negative for spend
  amountCents       Int
  kind              String   // "topup" | "spend" | "refund" | "adjustment" | "promo"
  description       String?
  // Polar (Stripe-backed) references
  polarCheckoutId   String?
  polarOrderId      String?
  createdAt         DateTime @default(now())
}

// A redeemable promo code that grants wallet credit (e.g. "free printing").
// Redeeming a code tops up the user's wallet, which the print flow then
// debits — so no special-casing is needed elsewhere.
model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique // stored uppercase, e.g. "FREEPRINT2026"
  valueCents     Int               // credit granted per redemption
  maxRedemptions Int?              // total cap across all users; null = unlimited
  redeemedCount  Int               @default(0)
  active         Boolean           @default(true)
  expiresAt      DateTime?         // null = never expires
  note           String?           // internal label
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  redemptions    PromoRedemption[]
}

// One row per (code, user). The unique constraint enforces "once per user".
model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([userId])
}
