// Cloud Print SaaS – schema
// Datastore: Neon Postgres (serverless).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Account type. A single users table backs all three roles; the role gates
// which dashboard and actions are available.
enum Role {
  CUSTOMER // prints files, pays from wallet (default)
  MERCHANT // owns printers, sees their throughput + earnings
  ADMIN    // manages merchants and printers, sees everything
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  phone         String?
  role          Role     @default(CUSTOMER)
  walletCents   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs           PrintJob[]
  transactions   WalletTx[]
  uploads        Upload[]
  redemptions    PromoRedemption[]
  // Printers this user owns (only meaningful for MERCHANT accounts).
  ownedPrinters  Printer[]  @relation("PrinterOwner")
}

model Printer {
  id                 String   @id @default(cuid())
  // PrintNode numeric printer id (nullable while offline / newly added)
  printNodeId        Int?     @unique
  name               String
  location           String   // e.g. "СБД, 1-р хороо, Central Tower"
  district           String   // e.g. "Сүхбаатар дүүрэг"
  address            String?
  colorSupported     Boolean  @default(false)
  duplexSupported    Boolean  @default(false)
  active             Boolean  @default(true)
  operatorEmail      String?  // legacy free-text contact; superseded by merchant
  // Owning merchant (nullable: printers can exist unassigned, and legacy rows
  // predate ownership). onDelete: SetNull so removing a merchant orphans rather
  // than deletes their printers.
  merchantId         String?
  merchant           User?    @relation("PrinterOwner", fields: [merchantId], references: [id], onDelete: SetNull)
  bwCentsPerPage     Int?     // per-printer override
  colorCentsPerPage  Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  jobs               PrintJob[]

  @@index([merchantId])
}

model Upload {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  storedPath  String   // filesystem path under /uploads
  mimeType    String
  sizeBytes   Int
  pageCount   Int?     // best-effort page count for PDFs
  createdAt   DateTime @default(now())

  jobs        PrintJob[]
}

model PrintJob {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId       String
  upload         Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  printerId      String
  printer        Printer   @relation(fields: [printerId], references: [id])
  copies         Int       @default(1)
  color          Boolean   @default(false)
  duplex         Boolean   @default(false)
  pageCount      Int       @default(1)
  costCents      Int       @default(0)
  status         String    @default("queued") // queued | sent | printed | failed | canceled
  // How the job reaches the printer:
  //   "printnode" — dispatched to the PrintNode cloud (default, legacy)
  //   "agent"     — left queued for a local agent (n8n) on the shop PC to pull
  deliveryMethod String    @default("printnode")
  // PrintNode job ids exceed 32-bit int range — must be BigInt.
  printNodeJobId BigInt?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model WalletTx {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // positive for top-up, negative for spend
  amountCents       Int
  kind              String   // "topup" | "spend" | "refund" | "adjustment" | "promo"
  description       String?
  // Polar (Stripe-backed) references
  polarCheckoutId   String?
  polarOrderId      String?
  // Bonum Gateway references. bonumInvoiceId is the idempotency key for the
  // payment webhook (Bonum may retry delivery of the same PAYMENT event).
  bonumInvoiceId    String?  @unique
  bonumTransactionId String?
  createdAt         DateTime @default(now())
}

// A redeemable promo code that grants wallet credit (e.g. "free printing").
// Redeeming a code tops up the user's wallet, which the print flow then
// debits — so no special-casing is needed elsewhere.
model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique // stored uppercase, e.g. "FREEPRINT2026"
  valueCents     Int               // credit granted per redemption
  maxRedemptions Int?              // total cap across all users; null = unlimited
  redeemedCount  Int               @default(0)
  active         Boolean           @default(true)
  expiresAt      DateTime?         // null = never expires
  note           String?           // internal label
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  redemptions    PromoRedemption[]
}

// One row per (code, user). The unique constraint enforces "once per user".
model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([userId])
}
